# Copie para .env e preencha. O arquivo .env NUNCA vai para o git (RNF12).

# Django
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL — o banco sobe na tarefa A2
POSTGRES_DB=mercadinho
POSTGRES_USER=mercadinho
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Telegram — usado a partir da tarefa H5. Deixe vazio até lá.
TELEGRAM_BOT_TOKEN=

# Registro de log (tarefa A3). Deixe LOG_ARQUIVO vazio para gravar só no console.
LOG_NIVEL=INFO
LOG_ARQUIVO=logs/mercadinho.log
