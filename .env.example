# Copie para .env e preencha. O arquivo .env NUNCA vai para o git (RNF12).

# Django
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL — o banco sobe na tarefa A2
POSTGRES_DB=mercadinho
POSTGRES_USER=mercadinho
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Telegram — bot dos avisos (H5). Crie o bot no @BotFather e cole o token aqui. Vazio: nenhum
# aviso sai (ficam guardados para quando o bot for configurado).
TELEGRAM_BOT_TOKEN=
# Segredo do webhook (H7): o Telegram o manda em toda resposta do dono. Invente um texto longo
# (só letras, números, _ e -). Vazio: nenhuma resposta é aceita.
TELEGRAM_WEBHOOK_SEGREDO=

# Registro de log (tarefa A3). Deixe LOG_ARQUIVO vazio para gravar só no console.
LOG_NIVEL=INFO
LOG_ARQUIVO=logs/mercadinho.log

# Quantas horas o login vale antes de pedir a senha de novo (tarefa A4).
SESSAO_VALIDADE_HORAS=12

# Quantos proxies há na frente da API (0 em desenvolvimento; 1 atrás de um proxy na publicação).
API_NUM_PROXIES=0
